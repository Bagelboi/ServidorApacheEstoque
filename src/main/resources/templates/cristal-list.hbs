<h1>Lista de Cristais</h1>

<!-- CSV import form -->
<form action="/cristais/import" method="post" enctype="multipart/form-data" style="display:inline-block; margin-left:10px;">
    <label for="csv-file" style="cursor:pointer; padding:6px 10px; background:#2d89ef; color:white; border-radius:4px;">
        Importar CSV
    </label>
    <input id="csv-file" name="file" type="file" accept=".csv" style="display:none;" />
    <button id="csv-submit" type="submit">Upload</button>
    <small style="display:block; font-size:0.9em; margin-top:6px;">CSV cols: sku,ean,titulo,estoque,peso,cor,tamanho</small>
</form>

<!-- Export button -->
<br>
<a href="/cristais/export" style="padding:6px 10px; background:#28a745; color:white; border-radius:4px; text-decoration:none; margin-left:10px;">
    Exportar CSV
</a>

<a href="/cristais/new">Novo Cristal</a>
<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>SKU</th>
            <th>EAN</th>
            <th>Título</th>
            <th>Estoque</th>
            <th>Cor</th>
            <th>Tamanho</th>
            <th>Descrição</th>
            <th>Peso</th>
            <th>Preço Padrão</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        {{#each cristais}}
        <tr>
            <td>{{sku}}</td>
            <td>{{ean}}</td>
            <td>{{titulo}}</td>
            <td>{{estoque}}</td>
            <td>{{cor}}</td>
            <td>{{tamanho}}</td>
            <td>{{peso}}</td>
            <td>{{precoPadrao}}</td>
            <td>{{descricao}}</td>
            <td>
                <a href="/cristais/edit/{{sku}}">Editar</a>
                <form action="/cristais/delete/{{sku}}" method="post" style="display:inline;">
                    <button type="submit" onclick="return confirm('Tem certeza que deseja excluir?')">Excluir</button>
                </form>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
