<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-2.2.4.min.js" integrity="sha256-BbhdlvQf/xTY9gja0Dq3HiwQF8LaCRTXxZKRutelT44=" crossorigin="anonymous"></script>
    <script src="//cdn.datatables.net/2.3.5/js/dataTables.min.js"></script>
</head>
<body>
<h2>Eventos de Conferência</h2>
<table id="eventTable">
  <thead>
    <tr>
      <th>SKU</th>
      <th>Data</th>
      <th>Estoque Novo</th>
      <th>Origem</th>
    </tr>
  </thead>
  <tbody>
    {{#each eventos}}
      <tr>
        <td>{{sku}}</td>
        <td>{{data}}</td>
        <td>{{estoque_novo}}</td>
        <td>{{origem}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

<h2>Criar Conferência</h2>
<div>
  <label>SKU:</label>
  <input id="sku-input" type="text" />
  <button id="add-sku-btn">Adicionar SKU</button>
</div>
<div>
  <label>EAN Scanner:</label>
  <button id="ean-scanner-btn">Ativar Scanner</button>
  <input id="ean-input" type="number" style="display: none;" />
</div>

<table id="creation-table" border="1" cellpadding="4" cellspacing="0">
  <thead>
    <tr>
      <th>SKU</th>
      <th>EAN</th>
      <th>Estoque Velho</th>
      <th>Estoque Novo</th>
    </tr>
  </thead>
  <tbody>
    {{!-- Rows will be dynamically added here --}}
  </tbody>
</table>

<div>
  <label>Origem:</label>
  <input id="origem-input" type="text" />
</div>

<div>
  <button id="submit-conferencia-btn">Criar Conferência</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
<script>
  new DataTable("#eventTable")
  var notyf = new Notyf();
  let scannerActive = false;

  document.getElementById('add-sku-btn').addEventListener('click', async () => {
    const sku = document.getElementById('sku-input').value.trim();
    if (!sku) return;

      // Check if SKU already exists in the table
      const existingRow = Array.from(document.querySelectorAll('#creation-table tbody tr')).find(
        row => row.children[0] && row.children[0].textContent === sku
      );
      if (existingRow) {
        const estoqueNovoInput = existingRow.querySelector('.estoque-novo');
        estoqueNovoInput.value = parseInt(estoqueNovoInput.value) + 1;
        e.target.value = '';
        return;
      }

    const response = await fetch(`/produto/sku/${sku}`);
    if (response.ok) {
      const produto = await response.json();
      if (produto.exists) {
        addRowToTable(produto.sku, produto.ean, produto.estoque, 0);
      }
    }
  });

  document.getElementById('ean-scanner-btn').addEventListener('click', () => {
    scannerActive = !scannerActive;
    const eanInput = document.getElementById('ean-input');
    eanInput.style.display = scannerActive ? 'inline' : 'none';
    if (!scannerActive) eanInput.value = '';
  });

    document.getElementById('ean-input').addEventListener('keydown', async (e) => {
        if (e.key !== 'Enter') return;

        e.preventDefault();
        const ean = e.target.value.trim();
        if (!ean || ean == '') return;

        const tbody = document.querySelector('#creation-table tbody');

        // Try fetch produto by EAN
        let produto;
        try {
            let response = await fetch(`/produto/ean/${ean}`);
            if (response.ok) {
                produto = await response.json();
            }

            // Fallback: colecionaveis lookup if EAN >= 12
            if ((!produto || !produto.exists) && ean.length >= 12) {
                response = await fetch(`/colecionaveis/getSkuFromEAN/${ean}`);
                if (response.ok) {
                    const sku = await response.text();
                    if (sku) {
                        notyf.success(`${sku} atualizado com EAN novo`)
                        const prodResp = await fetch(`/produto/sku/${sku}`);
                        if (prodResp.ok) {
                            produto = await prodResp.json();
                        }
                    }
                }
            }

            if (!produto || !produto.exists) {
                notyf.error('EAN não encontrado.');
                return;
            }

            // Check if SKU already exists in the table
            const existingRow = Array.from(tbody.querySelectorAll('tr')).find(
                row => row.dataset.sku === produto.sku
            );

            if (existingRow) {
                // Increment Estoque Novo
                const estoqueNovoInput = existingRow.querySelector('.estoque-novo');
                estoqueNovoInput.value = parseInt(estoqueNovoInput.value) + 1;

                // Update EAN if different
                if (existingRow.children[1].textContent !== ean) {
                    existingRow.children[1].textContent = ean;
                }

            } else {
                // Add new row if SKU not in table
                addRowToTable(produto.sku, produto.ean, produto.estoque, 0);
            }

            e.target.value = '';
        } catch (err) {
            console.error(err);
            notyf.error('Erro ao buscar o EAN.');
        }
    });



  document.getElementById('submit-conferencia-btn').addEventListener('click', async () => {
    const rows = document.querySelectorAll('#creation-table tbody tr');
    const origem = document.getElementById('origem-input').value.trim();
    if (!origem || origem.length < 1) {
      notyf.error('Preencha o campo Origem.');
      return;
    }
    const eventos = Array.from(rows).map(row => ({
      sku: row.dataset.sku,
      estoque_novo: parseInt(row.querySelector('.estoque-novo').value),
      estoque_velho: parseInt(row.children[2].textContent),
      origem: origem
    }));

    for (const evento of eventos) {
      await fetch('/evento/conferencia/new', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(evento),
      });
    }

    location.reload();
  });

  function addRowToTable(sku, ean, estoqueVelho, estoqueNovo) {
    const tbody = document.querySelector('#creation-table tbody');
    const row = document.createElement('tr');
    row.dataset.sku = sku;

    row.innerHTML = `
      <td>${sku}</td>
      <td>${ean}</td>
      <td>${estoqueVelho}</td>
      <td><input class="estoque-novo" type="number" min="0" value="${estoqueNovo}" /></td>
    `;

    tbody.appendChild(row);
  }
</script>
</body>