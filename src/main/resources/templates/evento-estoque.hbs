<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-2.2.4.min.js" integrity="sha256-BbhdlvQf/xTY9gja0Dq3HiwQF8LaCRTXxZKRutelT44=" crossorigin="anonymous"></script>
    <script src="//cdn.datatables.net/2.3.5/js/dataTables.min.js"></script>
</head>
<body>
<h2>Criar Evento de Estoque</h2>
<form method="post" action="/evento/estoque/new">
    <div>
        <label>SKU:</label>
        <input name="sku" type="text" required />
    </div>
    <div>
        <label>Data:</label>
        <input name="data" type="date" />
        <small>(se vazio, usa hoje)</small>
    </div>
    <div>
        <label>Tipo:</label>
        <select name="tipo">
            <option value="ADICAO">ADICAO</option>
            <option value="DEDUCAO">DEDUCAO</option>
        </select>
    </div>
    <div>
        <label>Quantidade:</label>
        <input name="quantidade" type="number" min="1" value="1" required />
    </div>
    <div>
        <label>Origem:</label>
        <input name="origem" type="text" required />
    </div>
    <div>
        <button type="submit">Criar Evento</button>
    </div>
</form>

<hr />

<h2>Importar CSV de Eventos</h2>
<input type="file" id="csvFile" accept=".csv" />
<button id="importCsvBtn">Importar CSV</button>
<p id="importStatus"></p>

<button id="downloadTemplateBtn">Baixar Template</button>

<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
<script>
    var notyf = new Notyf();

    document.getElementById('importCsvBtn').addEventListener('click', async () => {
      const fileInput = document.getElementById('csvFile');
      const status = document.getElementById('importStatus');
      if (!fileInput.files.length) {
        notyf.error('Selecione um arquivo CSV primeiro.');
        return;
      }

      const file = fileInput.files[0];
      const text = await file.text();

      // Try both commas and semicolons as delimiters
      const delimiter = text.includes(';') ? ';' : ',';
      const rows = text.trim().split(/\r?\n/).map(r => r.split(delimiter).map(c => c.trim()));

      if (rows.length < 2) {
        notyf.error('O arquivo CSV parece vazio ou inválido.');
        return;
      }

      const header = rows[0].map(h => h.toLowerCase());
      const today = new Date().toISOString().split('T')[0];
      let successCount = 0;
      let failCount = 0;

      for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        const get = (name) => {
          const idx = header.indexOf(name);
          return idx >= 0 ? row[idx] : '';
        };

        const evento = {
          sku: get('sku'),
          data: get('data') || today,
          tipo: (get('tipo') || 'ADICAO').toUpperCase(),
          quantidade: parseInt(get('quantidade') || '0'),
          origem: get('origem')
        };

        if (!evento.sku) continue; // skip invalid lines

        try {
            const formData = new URLSearchParams();
            for (const key in evento) {
              formData.append(key, evento[key]);
            }

            await fetch('/evento/estoque/new', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: formData
            });
          if (res.ok) successCount++;
          else failCount++;
        } catch (e) {
          failCount++;
        }
      }

      status.textContent = `Importação concluída: ${successCount} sucesso(s), ${failCount} falha(s).`;
      notyf.success(status.textContent);
      location.reload();
    });


      document.getElementById('downloadTemplateBtn').addEventListener('click', () => {
      const csvContent = "sku,data,tipo,quantidade,origem\n"

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);

      const a = document.createElement('a');
      a.href = url;
      a.download = "template_eventos_estoque.csv";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
  });
</script>

<hr />

<h2>Eventos de Estoque</h2>
<table id="eventTable">
    <thead>
    <tr>
        <th>ID</th>
        <th>SKU</th>
        <th>Data</th>
        <th>Tipo</th>
        <th>Quantidade</th>
        <th>Origem</th>
    </tr>
    </thead>
    <tbody>
    {{#each eventos}}
        <tr>
            <td>{{id}}</td>
            <td>{{sku}}</td>
            <td>{{data}}</td>
            <td>{{tipo}}</td>
            <td>{{quantidade}}</td>
            <td>{{origem}}</td>
        </tr>
    {{/each}}
    </tbody>
</table>
<script>
    new DataTable("#eventTable")
</script>
</body>
