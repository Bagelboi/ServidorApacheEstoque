<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Formulário Romaneio</title>
    <style>
        label { display:block; margin-top:8px; }
        table { border-collapse: collapse; width: 100%; margin-top: 10px; }
        th, td { border: 1px solid #ccc; padding: 6px; }
        .btn { padding: 6px 10px; margin: 4px; }
    </style>
    <script src="https://code.jquery.com/jquery-2.2.4.min.js" integrity="sha256-BbhdlvQf/xTY9gja0Dq3HiwQF8LaCRTXxZKRutelT44=" crossorigin="anonymous"></script>
    <script src="https://parsleyjs.org/dist/parsley.min.js"></script>
    <script src="/parsley_brasil.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
</head>
<body>
<h1>{{buttonText}}</h1>

<form id="romForm" method="post" action="{{action}}" data-parsley-validate>
        <label>Nº Romaneio
            <input name="numeroRomaneio" min="0" type="number" value="{{romaneio.numeroRomaneio}}" required>
        </label>

        <label>Data emissão
            <input name="dataEmissao" type="date" value="{{romaneio.dataEmissao}}">
        </label>

        <label>Destinatário (nome)
            <input name="destinatarioNome" type="text" value="{{romaneio.destinatarioNome}}">
        </label>

        <label>Destinatário (documento)
            <input name="destinatarioDocumento" type="text" data-parsley-cpfcnpj required value="{{romaneio.destinatarioDocumento}}">
        </label>

        <label>Contato
            <input name="contato" type="text" value="{{romaneio.contato}}">
        </label>

        <label>Coleta
            <input name="coleta" type="text" value="{{romaneio.coleta}}">
        </label>

        <label>Transporte:
            <select name="transporte">
                {{#each transportes}}
                    <option value="{{name}}" {{selected}}>{{name}}</option>
                {{/each}}
            </select>
        </label>

        <label>Vendedor
            <input name="vendedor" type="text" value="{{romaneio.vendedor}}">
        </label>

        <label>OC
            <input name="oc" type="text" value="{{romaneio.oc}}">
        </label>

        <label>Nota Fiscal
            <input name="notaFiscal" type="number" value="{{romaneio.notaFiscal}}">
        </label>

        <label>Condição de pagamento
            <select name="condPagamento">
                {{#each condPagamentos}}
                    <option value="{{name}}" {{selected}}>{{name}}</option>
                {{/each}}
            </select>
        </label>

        <label>Desconto valor total
            <input name="descontoValorTotal" min="0" type="number" step=".01" value="{{romaneio.descontoValorTotal}}">
        </label>

        <label>Observações
            <textarea name="observacoes">{{romaneio.observacoes}}</textarea>
        </label>

    <h3>Produtos</h3>

    <table id="produtosTable">
        <thead>
        <tr>
            <th>SKU</th>
            <th>EAN</th>
            <th>Quantidade</th>
            <th>Valor unidade</th>
            <th>Remover</th>
        </tr>
        </thead>
        <tbody>
        {{#each romaneioProdutosEAN}}
            <tr data-sku="{{sku}}" data-ean="{{ean}}">
                <td>{{sku}}</td>
                <td>{{ean}}</td>
                <td><input type="number" value="{{quantidade}}" min="1"></td>
                <td><input type="number" step=".01" value="{{valor_unidade}}"></td>
                <td><button type="button" onclick="removeRow(this)">Remover</button></td>
            </tr>
        {{/each}}
        </tbody>
    </table>

    <p>
        <input id="newSku" placeholder="SKU (ex: FU123)" type="text">
        <input id="newQuant" placeholder="Quantidade" type="number" value="1" min="1">
        <input id="newValor" placeholder="Valor unit." type="number" step=".01" value="-1.00">
        <button id="addProduto" type="button" class="btn">Adicionar produto</button>
    </p>

    <!-- EAN Scanner Button -->
    <p>
        <button id="ean-scanner-btn" type="button" class="btn">Ativar Scanner EAN</button>
        <input id="ean-input" type="number" style="display: none;" placeholder="Digite ou escaneie o EAN">
    </p>

    <!-- Import CSV Button -->
    <p>
        <input type="file" id="csvFile" accept=".csv" style="display:none">
        <button id="importCsvBtn" type="button" class="btn">Importar Produtos em Massa (sku, quantidade, valor)</button>
    </p>
    <!-- Export CSV Button -->
    <p>
        <button id="exportCsvBtn" type="button" class="btn">Baixar Template</button>
    </p>


    <!-- Hidden input to submit JSON of produtos -->
    <input type="hidden" name="produtosJson" id="produtosJson">

    <p>
        <button type="submit" class="btn">{{buttonText}}</button>
        <a class="btn" href="/rom">Cancelar</a>
    </p>
</form>

<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
<script>
    var notyf = new Notyf();

    function removeRow(btn) {
      btn.closest('tr').remove();
    }

    document.getElementById('addProduto').addEventListener('click', function() {
        var sku = document.getElementById('newSku').value.trim();
        if (!sku) { notyf.error('Informe um SKU.'); return; }
        var quant = parseInt(document.getElementById('newQuant').value, 10) || 0;
        var valor = parseFloat(document.getElementById('newValor').value);
        if (isNaN(valor)) valor = 0.0;

        if (!/^(FU|CR)/.test(sku)) {
            if (!confirm('SKU não parece ser FU/CR. Deseja adicionar mesmo assim?')) return;
        }

        fetchAndAddProduto(sku, quant, valor);
    });

    // --- EAN Scanner Logic ---
    let scannerActive = false;
    document.getElementById('ean-scanner-btn').addEventListener('click', () => {
        scannerActive = !scannerActive;
        const eanInput = document.getElementById('ean-input');
        eanInput.style.display = scannerActive ? 'inline' : 'none';
        if (!scannerActive) eanInput.value = '';
        if (scannerActive) eanInput.focus();
    });

    document.getElementById('ean-input').addEventListener('keydown', async (e) => {
        if (e.key !== 'Enter') return;

        e.preventDefault();
        const ean = e.target.value.trim();
        if (!ean || ean == '') return;

        const tbody = document.querySelector('#produtosTable tbody');
        const existingRow = Array.from(tbody.querySelectorAll('tr')).find(tr => tr.dataset.ean === ean);

        if (existingRow) {
            const quantInput = existingRow.querySelector('input[type="number"]');
            quantInput.value = parseInt(quantInput.value) + 1;
            e.target.value = '';
            return;
        }

        try {
            // Try produto endpoint
            let response = await fetch(`/produto/ean/${ean}`);
            if (response.ok) {
                const prod = await response.json();
                if (prod?.sku) {
                    fetchAndAddProduto(prod.sku, 1, -1, prod.ean);
                    e.target.value = '';
                    return;
                }
            }

            // Try colecionaveis fallback
            if (ean.length >= 12) {
                response = await fetch(`/colecionaveis/getSkuFromEAN/${ean}`);
                if (response.ok) {
                    const sku = await response.text();
                    if (sku) {
                        notyf.success(`${sku} atualizado com EAN novo`)
                        const prodResp = await fetch(`/produto/${sku}`);
                        if (prodResp.ok) {
                            const prod = await prodResp.json();
                            if (prod?.sku) {
                                fetchAndAddProduto(prod.sku, 1, -1, prod.ean);
                                e.target.value = '';
                                return;
                            }
                        }
                    }
                }
            }

        } catch (err) {
            console.error(err);
            notyf.error('Erro ao buscar EAN.');
        }
    });


    function fetchAndAddProduto(sku, quant, valor, eanFromScanner) {
        fetch(`/produto/sku/${sku}`)
            .then(resp => {
                if (!resp.ok) throw new Error('Produto não encontrado');
                return resp.json();
            })
            .then(prod => {
                if (!prod) return;

                if (valor < 0) {
                    if (prod.precoPadrao != null) valor = prod.precoPadrao;
                    else notyf.success('Preço padrão não encontrado para este SKU. Usando -1.');
                }
                addProdutoRow(sku, quant, valor, eanFromScanner || prod.ean || '');
            })
            .catch(() => {
                if (/^(FU|CR)/.test(sku)) return;
                notyf.error(`Produto ${sku} não encontrado no banco de dados.`);
            });
    }


    function addProdutoRow(sku, quant, valor, ean) {
        var tbody = document.querySelector('#produtosTable tbody');

        // Try to match by SKU (ignore EAN differences)
        var existing = Array.from(tbody.querySelectorAll('tr')).find(tr => tr.dataset.sku === sku);

        if (existing) {
            // Increment quantity
            var quantInput = existing.querySelector('input[type="number"]');
            quantInput.value = parseInt(quantInput.value) + quant;

            // Update EAN if it's missing or different
            if (ean && existing.dataset.ean !== ean) {
                existing.dataset.ean = ean;
                existing.querySelector('td:nth-child(2)').textContent = ean;
            }

            // Update value if needed (optional: only if valor > 0)
            var valorInput = existing.querySelector('input[type="number"]:nth-child(2)');
            if (valor > 0) valorInput.value = valor;

            return;
        }

        // If no existing SKU, create new row
        var tr = document.createElement('tr');
        tr.setAttribute('data-sku', sku);
        tr.setAttribute('data-ean', ean || '');
        tr.innerHTML = `
            <td>${sku}</td>
            <td>${ean || ''}</td>
            <td><input type="number" value="${quant}" min="1"></td>
            <td><input type="number" step="0.01" value="${valor}"></td>
            <td><button type="button" onclick="removeRow(this)">Remover</button></td>
        `;
        tbody.appendChild(tr);
    }

        // --- CSV Export Logic ---
    document.getElementById('exportCsvBtn').addEventListener('click', function () {
        const rows = [];
        rows.push(["sku", "quantidade", "valor"].join(",")); // header

        const csvContent = rows.join("\n")
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);

        // Create & click link
        const a = document.createElement("a");
        a.href = url;
        a.download = "produtos_romaneio_template.csv";
        a.style.display = "none";
        document.body.appendChild(a);
        a.click();

        // Cleanup
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    });

    // --- CSV Import Logic ---
    const importBtn = document.getElementById('importCsvBtn');
    const csvInput = document.getElementById('csvFile');

    importBtn.addEventListener('click', () => csvInput.click());

    csvInput.addEventListener('change', function() {
        const file = this.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const lines = e.target.result.split(/\r?\n/).filter(l => l.trim().length > 0);
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i];
                const parts = line.split(',').map(p => p.trim());
                if (parts.length < 3) continue;

                const sku = parts[0];
                const quant = parseInt(parts[1], 10) || 0;
                const valor = parseFloat(parts[2]) || -1.0;

                if (!sku) continue;
                fetchAndAddProduto(sku, quant, valor);
            }
        };
        reader.readAsText(file, 'UTF-8');
        this.value = ''; // Reset for future imports
    });

    // --- Form Submit ---
    document.getElementById('romForm').addEventListener('submit', function(e) {
      var produtos = [];
      document.querySelectorAll('#produtosTable tbody tr').forEach(tr => {
        var sku = tr.getAttribute('data-sku');
        var ean = tr.getAttribute('data-ean');
        var inputs = tr.querySelectorAll('input[type="number"]');
        var quant = parseInt(inputs[0].value, 10) || 0;
        var valor = parseFloat(inputs[1].value) || 0.0;
        produtos.push({ sku, ean, quantidade: quant, valor_unidade: valor });
      });
      document.getElementById('produtosJson').value = JSON.stringify(produtos);
    });
</script>

</body>
</html>
